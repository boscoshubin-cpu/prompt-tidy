{
  "manifest_version": 3,
  "name": "Prompt Tidy",
  "version": "0.1.0",
  "description": "Locally tidy ChatGPT drafts before you send them.",
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "world": "ISOLATED"
  }],
  "action": { "default_title": "Prompt Tidy" }
}
