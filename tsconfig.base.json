{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["DOM", "ES2022"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["node", "chrome"]
  },
  "include": ["packages/**/*.ts", "extension/**/*.ts", "extension/**/*.tsx", "tests/**/*.ts", "*.ts"]
}
